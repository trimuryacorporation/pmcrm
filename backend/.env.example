PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/trimurya_crm
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
SETTINGS_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
# Comma-separated frontend origins are supported.
CLIENT_URL=http://localhost:5173,https://your-frontend.vercel.app
UPLOAD_DRIVER=r2

# Used by npm run admin:ensure
ADMIN_EMAIL=superadmin@trimurya.com
ADMIN_PASSWORD=password123

# Optional Cloudflare R2 configuration
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=projectdocuments

# SMTP email notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Trimurya CRM <notifications@trimurya.com>

# Meta WhatsApp Cloud API template notifications
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=project_assignment
WHATSAPP_TEMPLATE_LANGUAGE=en_US
DEFAULT_PHONE_COUNTRY_CODE=91
